#!/usr/bin/with-contenv bashio
if ! bashio::config.true 'geoip'; then
    exec sleep infinity
fi

while true; do
    sleep 86400
    if [[ -n $(find /config/geoip/DBIP-City-Lite.mmdb -mtime -30 2>/dev/null) ]]; then
        continue
    fi
    geoip-update && caddy reload --force --config /etc/caddy/Caddyfile --adapter caddyfile
done
